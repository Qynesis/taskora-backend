{
  "name": "monolith-modular-example",
  "version": "0.0.1",
  "description": "NestJS modular monolith monorepo template",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build api && nest build worker",
    "postinstall": "tsc -p packages/shared-types/tsconfig.lib.json",
    "start:api": "nest start api --watch",
    "start:worker": "nest start worker --watch",
    "start:all": "concurrently \"npm run start:api\" \"npm run start:worker\"",
    "start:api:prod": "node dist/apps/api/main.js",
    "start:worker:prod": "node dist/apps/worker/main.js",
    "start:pm2": "pm2 start ecosystem.config.js --env production",
    "lint": "eslint \"{apps,packages}/**/*.ts\"",
    "lint:fix": "eslint \"{apps,packages}/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,packages}/**/*.ts\"",
    "test": "jest --testPathPattern=\\.spec\\.ts$",
    "test:watch": "jest --testPathPattern=\\.spec\\.ts$ --watch",
    "test:cov": "jest --testPathPattern=\\.spec\\.ts$ --coverage",
    "test:e2e": "jest --runInBand --forceExit apps/api/test/app.e2e-spec.ts",
    "test:e2e:smoke": "jest --runInBand --forceExit apps/api/test/app.e2e-spec.ts",
    "test:e2e:infra": "jest --runInBand --forceExit apps/api/test/infra.e2e-spec.ts",
    "test:e2e:all": "jest --testPathPattern=e2e --runInBand --forceExit",
    "test:e2e:docker": "docker compose -f docker-compose.e2e.yml run --rm e2e",
    "migration:generate": "typeorm migration:generate",
    "migration:run": "ts-node -r tsconfig-paths/register -P tsconfig.json ./node_modules/typeorm/cli.js migration:run -d apps/api/src/database/data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register -P tsconfig.json ./node_modules/typeorm/cli.js migration:revert -d apps/api/src/database/data-source.ts",
    "migration:show": "ts-node -r tsconfig-paths/register -P tsconfig.json ./node_modules/typeorm/cli.js migration:show -d apps/api/src/database/data-source.ts",
    "db:ensure-schema:prod": "node dist/apps/api/database/ensure-schema.js",
    "migration:run:prod": "npm run db:ensure-schema:prod && node ./node_modules/typeorm/cli.js migration:run -d dist/apps/api/database/data-source.js",
    "migration:revert:prod": "node ./node_modules/typeorm/cli.js migration:revert -d dist/apps/api/database/data-source.js",
    "migration:show:prod": "node ./node_modules/typeorm/cli.js migration:show -d dist/apps/api/database/data-source.js",
    "db:schema:drop": "ts-node -r tsconfig-paths/register -P tsconfig.json ./node_modules/typeorm/cli.js schema:drop -d apps/api/src/database/data-source.ts",
    "seed": "ts-node apps/api/src/database/seed/run-seed.ts",
    "seed:prod": "node dist/apps/api/database/seed/run-seed.js"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.31.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.17",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.17",
    "@supabase/supabase-js": "^2.97.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.12.0",
    "cache-manager": "^7.0.0",
    "cache-manager-ioredis-yet": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.1",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.0",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.12.0",
    "pino": "^9.3.0",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.17.1",
    "rimraf": "^5.0.7",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "stripe": "^22.1.0",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0"
  },
  "overrides": {
    "glob": "^11.0.0",
    "minimatch": "^10.2.1",
    "tar": "^7.5.9",
    "js-yaml": "^4.1.1",
    "lodash": "^4.17.23",
    "tmp": "^0.2.5",
    "ajv": "^8.18.0",
    "typeorm": {
      "glob": "10.5.0"
    }
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.17",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
